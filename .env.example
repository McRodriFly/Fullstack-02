# Copiar a .env (ignorado por Git) y reemplazar los valores "cambiar".
# Lo leen Docker Compose y el backend (spring.config.import en application.yml).
# Sin comillas ni espacios alrededor del "=".

# Contenedor MySQL
MYSQL_ROOT_PASSWORD=cambiar
DB_NAME=audi_f1_store
DB_USER=audi
DB_PASSWORD=cambiar

# Conexión del backend
DB_HOST=localhost
DB_PORT=3306
